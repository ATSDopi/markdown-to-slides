{
  "name": "md2slides",
  "version": "1.0.0",
  "description": "Universal Markdown to Slides Converter — Transform any Markdown file into beautiful interactive presentations with Mermaid diagrams, PDF export, and custom themes.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "md2slides": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "tsc && vite build",
    "build:cli": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "npm run build:cli"
  },
  "keywords": [
    "markdown",
    "slides",
    "presentation",
    "reveal.js",
    "mermaid",
    "pdf",
    "converter",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "marked": "^14.1.2",
    "mermaid": "^11.4.0",
    "puppeteer": "^23.5.0",
    "reveal.js": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
